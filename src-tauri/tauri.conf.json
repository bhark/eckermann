{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Eckermann",
  "version": "0.2.0",
  "identifier": "dk.forn.eckermann",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "13.0",
      "files": {
        "Resources/da.lproj/InfoPlist.strings": "macos/da.lproj/InfoPlist.strings"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5OTBDOUY1RDhBODU1NzUKUldSMVZhalk5Y21RbWN5SkNZUExXL2k1QTZLVFdkZmU3ek8rQW1tVFhVTC80OCsxaTN6OVIyU2YK",
      "endpoints": [
        "https://github.com/bhark/eckermann/releases/latest/download/latest.json"
      ]
    }
  }
}
